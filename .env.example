# ─────────────────────────────────────────────────────────────────────────────
# EMBEDNET OS — Environment Variables
# Copy this file to .env and fill in all required values before starting.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# [REQUIRED] Google Gemini API Key
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# [REQUIRED] Panel Admin Secret — Bearer token for all /api/admin/* routes.
# Generate a strong random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PANEL_API_SECRET=""

# [REQUIRED] AES-256-GCM Vault Master Key — used to encrypt/decrypt agent credentials.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NEVER use a guessable string. NEVER commit this value.
VAULT_MASTER_KEY=""

# [OPTIONAL] App URL — used for self-referential links and OAuth callbacks.
APP_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# [OPTIONAL] Agent credentials — if set, auto-encrypted into vault on startup.
# Leave empty to add credentials manually through the Auth Manager panel.
# ─────────────────────────────────────────────────────────────────────────────
GITHUB_TOKEN=""
NOTION_API_KEY=""
OPENAI_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# [PHASE 2] Bale Bot Real Connection
# Get your bot token from BotFather in Bale: @BotFather
# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED for real Bale dispatch via /webhook/bale
BALE_BOT_TOKEN=""

# Optional: Secure webhook verification token (set same value in setWebhook)
BALE_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# [PHASE 2] Telegram Bot Real Connection
# Get from @BotFather on Telegram
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# [PHASE 2] WhatsApp via Evolution API v2
# Self-host Evolution API v2: https://github.com/EvolutionAPI/evolution-api
# ─────────────────────────────────────────────────────────────────────────────
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE="embednet-wa-primary"

# ─────────────────────────────────────────────────────────────────────────────
# [PHASE 2] SQLite database path (relative to project root)
# Default: ./data/embednet.db  — auto-created on first run
# ─────────────────────────────────────────────────────────────────────────────
# EMBEDNET_DB_PATH="./data/embednet.db"
